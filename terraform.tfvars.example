# ESXi Settings

vsphere_server          = "192.168.1.50"
vsphere_user            = "root"
vsphere_password        = "changeme"
allow_unverified_ssl    = true
datacenter              = "ha-datacenter"
esxi_host               = "192.168.1.50"
datastore               = "datastore1"
