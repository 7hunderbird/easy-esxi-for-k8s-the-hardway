# VM Settings

ssh_public_key          = "ssh-ed25519 AAAA... you@yourmachine"
ovf_path                = "ova/resolute-server-cloudimg-amd64.ova"
gateway                 = "10.240.0.1"
dns_server              = "1.1.1.1"
domain                  = "k8s.local"
